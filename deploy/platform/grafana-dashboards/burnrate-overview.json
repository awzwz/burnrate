{
  "title": "Burn Rate overview",
  "uid": "burnrate-overview",
  "description": "Request rate, errors and latency per service; Kafka consumer lag per worker; restarts and memory. Health checks and scrapes (/healthz, /readyz, /metrics) are excluded everywhere.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {"from": "now-3h", "to": "now"},
  "refresh": "30s",
  "tags": ["burnrate"],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": {"query": "label_values(br_http_requests_total, service)", "refId": "service"},
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {"selected": true, "text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Requests per second",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "area", "colorMode": "none"},
      "targets": [{"refId": "A", "expr": "sum(rate(br_http_requests_total{service=\"edge-api\", route!~\"/(healthz|readyz|metrics)\"}[5m]))", "legendFormat": "edge-api"}],
      "description": "Public API traffic (edge-api)."
    },
    {
      "id": 2, "type": "stat", "title": "5xx share, all services",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 2, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.005}, {"color": "red", "value": 0.02}]}}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "area", "colorMode": "value"},
      "targets": [{"refId": "A", "expr": "sum(rate(br_http_requests_total{status=~\"5..\", route!~\"/(healthz|readyz|metrics)\"}[5m])) / sum(rate(br_http_requests_total{route!~\"/(healthz|readyz|metrics)\"}[5m]))", "legendFormat": "5xx"}],
      "description": "Alert BurnRateHigh5xxRate fires per service above 2% for 5 minutes."
    },
    {
      "id": 3, "type": "stat", "title": "p95 latency, edge-api",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 3, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.3}, {"color": "red", "value": 1}]}}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "area", "colorMode": "value"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(br_http_request_seconds_bucket{service=\"edge-api\", route!~\"/(healthz|readyz|metrics)|.*rehearsal.*\"}[5m])))", "legendFormat": "p95"}],
      "description": "Rehearsal routes (streamed model answers) are excluded. Target 300 ms, alert above 1 s for 10 minutes."
    },
    {
      "id": 4, "type": "stat", "title": "Largest consumer lag",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 50}, {"color": "red", "value": 500}]}}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "area", "colorMode": "value"},
      "targets": [{"refId": "A", "expr": "max(sum by (consumergroup) (kafka_consumergroup_lag))", "legendFormat": "messages"}],
      "description": "Messages waiting in the most loaded worker's consumer group."
    },
    {
      "id": 5, "type": "timeseries", "title": "Request rate per service",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 1, "fillOpacity": 5, "showPoints": "never"}}},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (service) (rate(br_http_requests_total{service=~\"$service\", route!~\"/(healthz|readyz|metrics)\"}[$__rate_interval]))", "legendFormat": "{{service}}"}]
    },
    {
      "id": 6, "type": "timeseries", "title": "Error rate (5xx share) per service",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "custom": {"lineWidth": 1, "fillOpacity": 5, "showPoints": "never", "thresholdsStyle": {"mode": "line"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "transparent", "value": null}, {"color": "red", "value": 0.02}]}}},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (service) (rate(br_http_requests_total{service=~\"$service\", status=~\"5..\", route!~\"/(healthz|readyz|metrics)\"}[$__rate_interval])) / sum by (service) (rate(br_http_requests_total{service=~\"$service\", route!~\"/(healthz|readyz|metrics)\"}[$__rate_interval]))", "legendFormat": "{{service}}"}],
      "description": "The red line is the alert threshold (2%)."
    },
    {
      "id": 7, "type": "timeseries", "title": "p95 latency per service",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"lineWidth": 1, "fillOpacity": 0, "showPoints": "never", "thresholdsStyle": {"mode": "line"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "transparent", "value": null}, {"color": "red", "value": 1}]}}},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (service, le) (rate(br_http_request_seconds_bucket{service=~\"$service\", route!~\"/(healthz|readyz|metrics)\"}[$__rate_interval])))", "legendFormat": "{{service}}"}],
      "description": "All routes, including the ones that wait for a language model (llm-gateway, rehearsal): expect seconds there. The alert leaves those out. The red line is the alert threshold (1 s)."
    },
    {
      "id": 8, "type": "timeseries", "title": "Kafka consumer lag per worker",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"lineWidth": 1, "fillOpacity": 5, "showPoints": "never"}}},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (consumergroup) (kafka_consumergroup_lag)", "legendFormat": "{{consumergroup}}"}],
      "description": "Consumer group = worker name. KEDA adds a replica per 50 messages of lag. A worker that never consumed has no line."
    },
    {
      "id": 9, "type": "timeseries", "title": "Slowest routes (p95, top 10)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"lineWidth": 1, "fillOpacity": 0, "showPoints": "never"}}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "topk(10, histogram_quantile(0.95, sum by (service, route, le) (rate(br_http_request_seconds_bucket{service=~\"$service\", route!~\"/(healthz|readyz|metrics)\"}[5m]))))", "legendFormat": "{{service}} {{route}}"}]
    },
    {
      "id": 10, "type": "timeseries", "title": "Kafka consumer lag per worker and topic",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"lineWidth": 1, "fillOpacity": 0, "showPoints": "never"}}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag)", "legendFormat": "{{consumergroup}} / {{topic}}"}]
    },
    {
      "id": 11, "type": "timeseries", "title": "Container restarts (last 15 minutes)",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0, "custom": {"drawStyle": "bars", "fillOpacity": 60, "showPoints": "never"}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total{namespace=~\"burnrate|data|edge|envoy-gateway-system\"}[15m])) > 0", "legendFormat": "{{namespace}}/{{pod}}"}]
    },
    {
      "id": 12, "type": "timeseries", "title": "Memory in use per workload (namespace burnrate)",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "custom": {"lineWidth": 1, "fillOpacity": 0, "showPoints": "never"}}},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (container, pod) (container_memory_working_set_bytes{namespace=\"burnrate\", container=\"app\"})", "legendFormat": "{{pod}}"}],
      "description": "Working set of the application container of each pod. Requests are 128 Mi (256 Mi for engine and statement-extractor), limits 384 Mi (512 Mi)."
    }
  ]
}
