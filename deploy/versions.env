# Pinned versions of everything the platform installs. Sourced by deploy/scripts/lib.sh; the only place to bump.
#
# "seruen" = the version ran on the previous cluster (DOKS 1.35.9, October 2026) and is taken from that
#            project's deploy/README.md and bootstrap.sh. Still present in the chart repositories on 2026-11-15.
# "new"    = not used before; looked up on 2026-11-15. Not yet run on any cluster.

# ---- Helm charts ---------------------------------------------------------------------------------------------
V_ENVOY_GATEWAY=1.9.3      # new    oci://docker.io/envoyproxy/gateway-helm (Docker Hub tag list). Envoy Gateway 1.9.3,
                           #        built for Gateway API v1.6.1, supports Kubernetes 1.33-1.36 (project's matrix).
                           #        1.10.0 exists (2026-11-06) but is a nine-day-old .0; 1.8 went out of support 2026-11-08.
V_METRICS_SERVER=3.14.0    # seruen metrics-server 0.9.0
V_CERT_MANAGER=v1.21.2     # seruen
V_STRIMZI=1.3.0            # seruen Strimzi 1.3.0, Kafka 4.3.1
V_CNPG=0.29.1              # seruen CloudNativePG operator 1.30.1
V_KEDA=2.21.0              # seruen
V_KPS=92.10.1              # seruen kube-prometheus-stack (Prometheus 3.15, Grafana 13.2 there)
V_LINKERD=2026.10.1        # seruen linkerd-edge charts, edge-26.10.1
# profile "full" only
V_LOKI=7.3.0               # seruen Loki 3.6
V_TEMPO=1.24.4             # seruen Tempo 2.9.0
V_ALLOY=1.14.0             # seruen Alloy 1.21.0
V_ARGOCD=10.10.5           # seruen Argo CD 3.5.5
V_VAULT=0.34.1             # seruen Vault 2.0.4 (there in dev mode; here Raft with 3 pods, which is new)

# ---- Container images named in manifests (for reference; change them in the file named) ------------------------
# ghcr.io/cloudnative-pg/postgresql:17.12-standard-trixie   new  deploy/platform/cnpg/cluster-*.yaml
# valkey/valkey:8.1.11-alpine                               new  deploy/platform/valkey/valkey.yaml
# Kafka 4.3.1 (Strimzi's own image)                         seruen  deploy/platform/strimzi/kafka-*.yaml
# python:3.12-slim, ghcr.io/astral-sh/uv:0.13.1             new  Dockerfile
# node:24-slim, nginxinc/nginx-unprivileged:1.30.6-alpine   new  web/Dockerfile

# ---- Cluster ---------------------------------------------------------------------------------------------------
K8S_MINOR=1.35             # cluster.sh takes the newest 1.35.x slug DigitalOcean offers (seruen ran 1.35.9-do.1)
NODE_SIZE=s-4vcpu-8gb      # 4 vCPU / 8 GB, about 6.26 GiB allocatable per node (measured on the previous cluster)
NODE_COUNT=3               # the account limit
