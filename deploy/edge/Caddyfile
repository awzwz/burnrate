burnrate.67.207.94.96.sslip.io {
	encode zstd gzip

	# Who opened the product: one JSON line per request. Caddy redacts Cookie and Authorization by default.
	log {
		output file /var/log/caddy/burnrate-access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format json
	}

	# Never public, whichever backend answers.
	@private path /internal /internal/* /metrics /metrics/* /readyz /admin/api /admin/api/*
	handle @private {
		header Content-Type application/json
		respond `{"error":{"code":"not_found","message":"No such endpoint."}}` 404
	}

	# Moving to Kubernetes without signing anyone out: a session that was started on this server
	# (cookie br_session, no br_backend marker) keeps being served by the single process here;
	# everybody else goes to the cluster and gets the marker, so they stay there.
	@legacy {
		header Cookie *br_session=*
		not header Cookie *br_backend=k8s*
	}
	handle @legacy {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy http://157.230.67.121:80 {
			header_up Host {host}
			flush_interval -1
			header_down +Set-Cookie "br_backend=k8s; Path=/; Max-Age=2592000; Secure; HttpOnly; SameSite=Lax"
		}
	}
}

http://67.207.94.96 {
	redir https://burnrate.67.207.94.96.sslip.io{uri}
}
